# Caddy davanti al programma: fa l'HTTPS da solo, prende il certificato da
# Let's Encrypt e lo rinnova senza che nessuno se ne ricordi.
#
# Perche' Caddy e non nginx: tre righe invece di trenta, e il certificato
# non e' un lavoro da rifare a mano ogni tre mesi.

agenzia.stopandgogaranzie.it {
	# Il programma ascolta solo su 127.0.0.1: da fuori si passa di qui.
	reverse_proxy 127.0.0.1:8073 {
		# `header_up` vale SOLO dentro reverse_proxy: scritto fuori,
		# `caddy validate` rifiuta tutto il file — ed e' quel che e'
		# successo la prima volta, lasciando il sito senza certificato.
		#
		# Senza questa intestazione il biscotto della sessione esce
		# senza `Secure`: il programma guarda proprio lei per capire
		# se davanti c'e' HTTPS. Caddy la mette gia' da sola, ed e'
		# scritta qui perche' si veda.
		header_up X-Forwarded-Proto {scheme}
	}

	# Un documento d'identita' non si mette in nessuna memoria di
	# passaggio.
	header {
		Strict-Transport-Security "max-age=31536000"
		X-Frame-Options "DENY"
		-Server
	}

	encode gzip
	log {
		output file /var/log/caddy/targhe.log
	}
}
